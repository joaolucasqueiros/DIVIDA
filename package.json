{
  "name": "clareza",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "wrangler dev --ip 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test:db": "bash scripts/test-db.sh",
    "test:e2e": "playwright test",
    "prepare:env": "node scripts/prepare-env.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "pluggy-connect-sdk": "^2.12.0",
    "pluggy-js": "^0.19.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "read-excel-file": "^5.8.8",
    "recharts": "^3.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251001.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wrangler": "4.40.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
